<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roboarm">

  <ros2_control name="roboarm" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="base_body_joint">
      <command_interface name="position">
        <param name="min">${-pi / 2}</param>
        <param name="max">${pi / 2}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="body_root1_joint">
      <command_interface name="position">
        <param name="min">${-pi / 2}</param>
        <param name="max">${pi / 2}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_root2_joint">
      <command_interface name="position">
        <param name="min">${-pi / 2}</param>
        <param name="max">${pi / 2}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="forearm_root3_joint">
      <command_interface name="position">
        <param name="min">${-pi / 2}</param>
        <param name="max">${pi / 2}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_root4_joint">
      <command_interface name="position">
        <param name="min">${-pi / 2}</param>
        <param name="max">${pi / 2}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
    </joint>
    <joint name="palm_left_finger_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="palm_right_finger_joint">
      <param name="mimic">palm_left_finger_joint</param>
      <param name="multiplier">-1</param>
      <state_interface name="position"/>
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

</robot>