<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='ground_plane'>
    <static>true</static>  <!-- Неподвижный объект -->
    <link name='link'>
      <collision name='collision'>
        <geometry>
          <plane>
            <normal>0 0 1</normal>  <!-- Ориентация (горизонтальная плоскость) -->
            <size>100 100</size>     <!-- Размер 100x100 метров -->
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>    <!-- Трение -->
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='visual'>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>  <!-- Серый цвет -->
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>